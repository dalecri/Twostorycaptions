{
  "name": "twostorycaptions",
  "version": "1.0.0",
  "description": "TwoStoryCaptions: an offline caption planner, packaged with Capacitor",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "android:run": "npm run sync && npx cap run android",
    "icons": "npx capacitor-assets generate --android --iconBackgroundColor #F0F5FF --splashBackgroundColor #F0F5FF"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalecri/TwoStoryCaptions.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dalecri/TwoStoryCaptions/issues"
  },
  "homepage": "https://github.com/dalecri/TwoStoryCaptions#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "private": true
}
